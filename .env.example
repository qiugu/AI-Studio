# ============================================================
# AI-Studio 环境变量配置示例
# 复制本文件为 backend/.env 并填写实际值：
#   cp .env.example .env
# 注：变量名大小写不敏感，可照原样使用下方 UPPER_CASE 形式。
# ============================================================

# ---- 数据库 (MySQL) ----
DATABASE_TYPE=mysql
CONNECTOR=pymysql
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=ai_studio
DATABASE_USERNAME=ai_studio
DATABASE_PASSWORD=change-me-database-password
# Docker Compose 初始化 MySQL root；未设置时回退使用 DATABASE_PASSWORD。
MYSQL_ROOT_PASSWORD=change-me-mysql-root-password

# Docker 构建基础镜像（当前默认使用可配置镜像源；需要时可改回官方源）
PYTHON_BASE_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
NODE_BASE_IMAGE=docker.m.daocloud.io/library/node:20-alpine
NGINX_BASE_IMAGE=docker.m.daocloud.io/library/nginx:1.27-alpine

# ---- 对外端口（开发默认 3000；生产反向代理可设置为 80 或 443） ----
FRONTEND_PORT=3000
# DATABASE_SOCKET=            # 可选，使用 Unix socket 连接时填写（如 /tmp/mysql.sock）

# ---- 向量数据库 (Qdrant) ----
# 注意：代码实际使用的是 Qdrant，而非 README 旧文档中的 PostgreSQL+pgvector
QDRANT_URL=http://localhost:6333
# # 本地部署可留空；云端部署时填写
QDRANT_API_KEY=

# ---- Redis (缓存 / 限流 / Token 黑名单) ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# Redis 为临时状态与缓存设置内存上限；生产环境请按实例规格调整。
REDIS_MAXMEMORY=256mb
# Redis 同时保存 Token 撤销状态；禁止因淘汰策略丢失黑名单记录。
REDIS_MAXMEMORY_POLICY=noeviction

# ---- RabbitMQ (Celery Broker) ----
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=ai_studio
RABBITMQ_PASSWORD=change-me-rabbitmq-password
RABBITMQ_VHOST=ai-studio

# ---- JWT 认证 ----
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=5
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- RBAC 授权发布开关 ----
# membership 表完成回填和校验后，再在预发布环境开启增量双写；
# 读取来源仍保持旧路径，直到完成脱敏副本验证。
MEMBERSHIP_DUAL_WRITE_ENABLED=false
MEMBERSHIP_READ_MODE=legacy
REQUIRE_REAUTH_FOR_SENSITIVE_ACTIONS=true
AUTHZ_CACHE_TTL_SECONDS=5

# ---- 加密 (Fernet，用于第三方 API Key 的加密存储) ----
FERNET_KEY=your-fernet-key   # 可用 `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"` 生成

# 首次启动时创建平台管理员；两项同时配置，密码至少 12 位
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# ---- 文件上传 ----
UPLOAD_DIR=/tmp/ai_studio/uploads
MAX_UPLOAD_SIZE_MB=50

# ---- Celery 异步任务 ----
# 默认由上面的 RabbitMQ 分项生成 AMQP URL。托管 RabbitMQ 可显式覆盖：
# CELERY_BROKER_URL=amqps://user:password@managed-rabbitmq.example/vhost
# 业务状态写入 MySQL，默认禁用 Result Backend。
CELERY_RESULT_BACKEND=

# ---- Embedding 向量化 ----
EMBEDDING_PROVIDER=openai    # 可选：openai / ollama / 其他兼容 OpenAI 接口的供应商
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
# # 可选，自定义 / 兼容接口的 Base URL
EMBEDDING_API_BASE=

# ---- Ollama (本地大模型运行时) ----
OLLAMA_BASE_URL=http://localhost:11434

# ---- 出站访问策略 (SSRF 防护) ----
# 作用于插件调用与 Agent 的 API 工具：为 true 时拒绝访问私有地址、环回、
# 链路本地（含云元数据 169.254.169.254）等网段，防止平台被用作内网探测跳板。
# 仅在确需让插件访问内网服务时才置为 false（属有意识的降级，请同时限制网络出站范围）。
PLUGIN_BLOCK_PRIVATE_NETWORK=true
