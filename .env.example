# ============================================================
# AI-Studio Docker Compose 一键部署配置
# 使用方法：
#   cp .env.example .env   # 然后按需修改
#   docker compose up -d --build
# 注意：本文件与 backend/.env（本地开发）是两套独立配置。
# ============================================================

# ── MySQL ────────────────────────────────────────────────
# 密码请避免使用 $ 等会被环境展开的特殊字符
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=ai_studio
MYSQL_USER=ai_studio
MYSQL_PASSWORD=change-me-db-password

# ── JWT ──────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-jwt-secret-key
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Fernet 加密密钥（API Key 加密存储）────────────────────
# 生成方式：
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 注意：密钥丢失后已加密的 API Key 将无法解密！
FERNET_KEY=change-me-fernet-key

# ── 文件上传 ─────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50

# ── Embedding 向量化 ─────────────────────────────────────
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=

# ── Ollama 本地模型（可选）───────────────────────────────
# Linux 下通过 extra_hosts 自动映射 host.docker.internal
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ── 对外端口 ─────────────────────────────────────────────
# 前端访问端口（默认 80，被占用时可改为 8080 等）
FRONTEND_PORT=80
# 后端 API 文档端口（默认 8000；生产环境可删除 compose 中对应 ports 段）
BACKEND_PORT=8000
# Qdrant 管理面板端口（默认 6333；不需要可删除 compose 中对应 ports 段）
QDRANT_PORT=6333
