# ============================================================
# AI-Studio 环境变量配置示例
# 复制本文件为 backend/.env 并填写实际值：
#   cp .env.example .env
# 注：变量名大小写不敏感，可照原样使用下方 UPPER_CASE 形式。
# ============================================================

# ---- 数据库 (MySQL) ----
DATABASE_TYPE=mysql
CONNECTOR=pymysql
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=ai_studio
DATABASE_USERNAME=root
DATABASE_PASSWORD=your_password
# DATABASE_SOCKET=            # 可选，使用 Unix socket 连接时填写（如 /tmp/mysql.sock）

# ---- 向量数据库 (Qdrant) ----
# 注意：代码实际使用的是 Qdrant，而非 README 旧文档中的 PostgreSQL+pgvector
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=              # 本地部署可留空；云端部署时填写

# ---- Redis (缓存 / 限流 / Celery 消息中间件) ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ---- JWT 认证 ----
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=5
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- 加密 (Fernet，用于第三方 API Key 的加密存储) ----
FERNET_KEY=your-fernet-key   # 可用 `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"` 生成

# ---- 文件上传 ----
UPLOAD_DIR=/tmp/ai_studio/uploads
MAX_UPLOAD_SIZE_MB=50

# ---- Celery 异步任务 ----
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---- Embedding 向量化 ----
EMBEDDING_PROVIDER=openai    # 可选：openai / ollama / 其他兼容 OpenAI 接口的供应商
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=          # 可选，自定义 / 兼容接口的 Base URL

# ---- Ollama (本地大模型运行时) ----
OLLAMA_BASE_URL=http://localhost:11434
